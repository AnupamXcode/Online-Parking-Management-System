# ParkEase — Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=parkease-super-secure-production-secret-2026

# Local Database File Path (SQLite WAL)
DATABASE_PATH=server/db/parkease.db

# Production Persistent Database (Optional - Supabase / PostgreSQL)
# When deploying to Vercel production, configure a persistent PostgreSQL database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
